{
    "luci-app-honk": {
        "description": "Grant access for luci-app-honk",
        "read": {
            "ubus": {
                "service": [ "list" ],
                "honk": [ "getStats" ]
            },
            "uci": [ "honk" ],
            "file": {
                "/etc/honk/config.dae": [ "read" ],
                "/etc/honk/config.d/dns.dae": [ "read" ],
                "/etc/honk/config.d/node.dae": [ "read" ],
                "/etc/honk/config.d/route.dae": [ "read" ],
                "/var/log/honk/honk.log": [ "read" ],
                "/proc/uptime": [ "read" ],
                "/proc/*/status": [ "read" ],
                "/proc/*/stat": [ "read" ],
                "/proc/net/dev": [ "read" ],
                "/usr/bin/honk-core": [ "exec" ],
                "/etc/init.d/honk": [ "exec" ]
            }
        },
        "write": {
            "uci": [ "honk" ],
            "file": {
                "/etc/honk/config.dae": [ "write" ],
                "/etc/honk/config.d/dns.dae": [ "write" ],
                "/etc/honk/config.d/node.dae": [ "write" ],
                "/etc/honk/config.d/route.dae": [ "write" ],
                "/var/log/honk/honk.log": [ "write" ],
                "/etc/init.d/honk": [ "exec" ]
            }
        }
    }
}
