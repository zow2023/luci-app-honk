{
    "admin/services/honk": {
        "title": "HONK",
        "action": {
            "type": "firstchild"
        },
        "depends": {
            "acl": [ "luci-app-honk" ],
            "fs": {
                "/etc/init.d/honk": "executable"
            },
            "uci": {
                "honk": true
            }
        }
    },
    "admin/services/honk/status": {
        "title": "Control",
        "order": 10,
        "action": {
