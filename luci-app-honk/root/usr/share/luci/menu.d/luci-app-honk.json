        "action": {
            "type": "view",
            "path": "honk/dns"
        }
    },
    "admin/services/honk/node": {
        "title": "Node Settings",
        "order": 40,
        "action": {
            "type": "view",
            "path": "honk/node"
        }
    },
    "admin/services/honk/route": {
        "title": "Routing Settings",
        "order": 50,
        "action": {
            "type": "view",
            "path": "honk/route"
        }
    },
    "admin/services/honk/log": {
