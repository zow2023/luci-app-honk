# config.d/api.dae
# Enables the Clash-compatible HTTP API used by the LuCI status panel
# to read live/cumulative traffic stats via /stats.
# API is bound to localhost only; no external exposure, no auth needed.
experimental {
    clash_api {
        external_controller: '127.0.0.1:9090'
        external_ui: 'zashboard'
        secret: ''
        default_mode: 'Rule'
    }
}

# v0.1.0-beta.1 起，面板 ZIP 的下载 URL 与下载路由移入 assets {} 块
# （experimental.clash_api.external_ui_download_* 为 legacy 键，见迁移文档）
assets {
    ui {
        route: direct
    }
}
