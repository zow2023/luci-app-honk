#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-only
#
# luci-app-honk companion init script (modified 2026-08-31)
# 主要改动（针对 LuCI "Reload Service" 30s XHR timeout）：
#   1. 借鉴 duck：cleanup_netns 不再 ip link 直接 del，改为先 tc qdisc del clsact
#      让 eBPF pin 主动解绑，再删 link，避免内核等进程退出再到 30s。
#   2. 鉴于 honk-core 上游将 "重载逻辑" 标为 [ ] 未 review，
#      hot_reload 用 timeout 3 包裹 daemon reload，超时立即后台 restart。
#   3. 借鉴 duck：start_service 删 netdev / term_timeout / respawn 3600 5 5
#      三项 procd_set_param，避免 procd reply 在 stop/start 切换时被拖住。
#   4. 新增 PID 文件 /var/run/honk.pid，让 hot_reload 能 PID-aware 调用 honk-core。
#   5. fallback restart 用 >/dev/null 2>&1 & 异步执行，rpcd 立刻收到 exit 0，
#      不再走同步 start_service，把前端 30s XHR timeout 链打断。

USE_PROCD=1
START=96
STOP=10

extra_command "hot_reload" "Reload service (in-process reload if running, async restart otherwise)"
extra_command "refresh_config" "Refresh remote configuration only" 2>/dev/null
extra_command "check_config" "Validate current configuration" 2>/dev/null

CONF="honk"
PROG="/usr/bin/honk-core"
PID_FILE="/var/run/honk.pid"

HONK_HOST_IFACE="dae0"
HONK_PEER_IFACE="dae0peer"
HONK_NETNS_NAME="daens"
HONK_NETNS_PATH="/run/netns/$HONK_NETNS_NAME"

LOG_DIR="/var/log/honk"
LOG_FILE="$LOG_DIR/honk.log"
LOG_OLD_FILE="$LOG_FILE.old"
LOG_MAX_SIZE=1048576    # 1MB
LOG_MONITOR_PID="/var/run/honk_log_monitor.pid"
LOG_ROTATE_INTERVAL=300 # 每 5 分钟检查一次日志大小

RESOLV_HONK="/tmp/resolv.conf.honk"

set_chmod_640() {
    mkdir -p /etc/honk/config.d
    # 保留符号权限，确保目录可执行，文件仅读写
    chmod -R u=rwX,g=rX,o= /etc/honk/ 2>/dev/null || true
}

# 检查程序是否可执行
check_prog() {
    [ -x "$PROG" ] || {
        logger -t honk "start_service: $PROG not found or not executable"
        return 1
    }
    return 0
}

prepare_log() {
    mkdir -p "$LOG_DIR"
    if [ -f "$LOG_FILE" ]; then
        local size
        size=$(wc -c < "$LOG_FILE" 2>/dev/null)
        case "$size" in
            ''|*[!0-9]*) size=0 ;;
        esac
        if [ "$size" -gt "$LOG_MAX_SIZE" ]; then
            mv "$LOG_FILE" "$LOG_OLD_FILE" 2>/dev/null || true
        fi
    fi
    [ -f "$LOG_FILE" ] || touch "$LOG_FILE"
    chmod 640 "$LOG_FILE" 2>/dev/null || true
}

stop_log_monitor() {
    if [ -f "$LOG_MONITOR_PID" ]; then
        local old_pid
        old_pid="$(cat "$LOG_MONITOR_PID" 2>/dev/null)"
        case "$old_pid" in
            ''|*[!0-9]*) ;;
            *) kill "$old_pid" 2>/dev/null || true ;;
        esac
        rm -f "$LOG_MONITOR_PID"
    fi
}

rotate_log() {
    local size
    [ -f "$LOG_FILE" ] || return 0
    size=$(wc -c < "$LOG_FILE" 2>/dev/null) || return 0
    case "$size" in
        ''|*[!0-9]*) return 0 ;;
    esac
    [ "$size" -gt "$LOG_MAX_SIZE" ] || return 0

    # copytruncate 方式：复制后截断，避免影响正在写入的进程
    cp "$LOG_FILE" "$LOG_OLD_FILE" 2>/dev/null || return 0
    : > "$LOG_FILE"
    chmod 640 "$LOG_FILE" 2>/dev/null || true
}

log_monitor() {
    echo "$$" > "$LOG_MONITOR_PID"
    trap 'rm -f "$LOG_MONITOR_PID"; exit 0' INT TERM EXIT
    while :; do
        sleep "$LOG_ROTATE_INTERVAL"
        rotate_log
    done
}

# 借鉴 duck：先拆 clsact 上的 eBPF pinned prog，再删 link/netns，
# 否则 eBPF 内核对象会拖住 ip link del 长达 20+ 秒，最终撑爆 rpcd 30s 超时。
cleanup_netns() {
    tc qdisc del dev "$HONK_HOST_IFACE" clsact 2>/dev/null || true
    ip link del "$HONK_HOST_IFACE"  2>/dev/null || true
    ip link del "$HONK_PEER_IFACE" 2>/dev/null || true
    ip netns del "$HONK_NETNS_NAME" 2>/dev/null || true
    umount "$HONK_NETNS_PATH"      2>/dev/null || true
    rm -f "$HONK_NETNS_PATH" "$PID_FILE" 2>/dev/null || true
}

hijack_resolv_conf() {
    grep -q ' /tmp/resolv\.conf ' /proc/mounts && return 0

    grep -E '^(search|domain) ' /tmp/resolv.conf > "$RESOLV_HONK" 2>/dev/null

    local dns_list LOGICAL_WAN
    . /lib/functions/network.sh
    network_find_wan LOGICAL_WAN 2>/dev/null

    if [ -n "$LOGICAL_WAN" ]; then
        dns_list=$(ubus call "network.interface.$LOGICAL_WAN" status 2>/dev/null | \
            jsonfilter -e '@["dns-server"][*]' 2>/dev/null)
    fi

    if [ -z "$dns_list" ] && [ -f "/tmp/resolv.conf.d/resolv.conf.auto" ]; then
        dns_list=$(awk '/^nameserver/{print $2}' "/tmp/resolv.conf.d/resolv.conf.auto")
    fi

    local added=0
    for dns in $dns_list; do
        case "$dns" in
            *[!0-9a-fA-F:.%]*|'') continue ;;
        esac
        echo "nameserver $dns" >> "$RESOLV_HONK"
        added=1
    done

    if [ "$added" -eq 0 ]; then
        echo "nameserver 119.29.29.29" >> "$RESOLV_HONK"
        echo "nameserver 223.5.5.5" >> "$RESOLV_HONK"
    fi

    mount --bind "$RESOLV_HONK" /tmp/resolv.conf 2>/dev/null || true
    mount -o remount,ro,bind /tmp/resolv.conf 2>/dev/null || true
}

restore_resolv_conf() {
    if grep -q ' /tmp/resolv\.conf ' /proc/mounts; then
        umount -l /tmp/resolv.conf 2>/dev/null || true
    fi
    rm -f "$RESOLV_HONK"
}

# 等价 duck 的 reload_daemon，PID-aware；honk-core 内置 reload 路径
# 上游仍标 [ ] review，因此我们用 timeout 3 包裹：3s 没回包视为不可用。
try_reload_daemon() {
    if ! /etc/init.d/honk running >/dev/null 2>&1; then
        logger -t honk "try_reload_daemon: service not running"
        return 1
    fi
    local pid=""
    if [ -r "$PID_FILE" ]; then
        pid="$(cat "$PID_FILE" 2>/dev/null)"
        case "$pid" in
            ''|*[!0-9]*) pid="" ;;
        esac
    fi
    if [ -n "$pid" ]; then
        timeout 3 "$PROG" reload "$pid" >/dev/null 2>&1
    else
        timeout 3 "$PROG" reload     >/dev/null 2>&1
    fi
}

start_service() {
    local enabled config_file tz_value

    config_load "$CONF"
    config_get_bool enabled "config" "enabled" "0"

    logger -t honk "start_service: enabled=$enabled"

    [ "$enabled" -eq "1" ] || {
        logger -t honk "start_service: disabled, not starting"
        return 1
    }

    check_prog || return 1

    config_get config_file "config" "config_file" "/etc/honk/config.dae"

    # 清理可能残留的旧日志监控进程
    stop_log_monitor

    set_chmod_640
    prepare_log

    cleanup_netns
    hijack_resolv_conf

    tz_value="$(cat /etc/TZ 2>/dev/null)"

    procd_open_instance "$CONF"

    [ -n "$tz_value" ] && procd_set_param env TZ="$tz_value"
    procd_set_param env DAE_LOCATION_ASSET="/usr/share/v2ray"

    # 使用 honk-core 自带的 --log-file 参数记录日志
    procd_set_param command "$PROG" --config "$config_file" --log-file "$LOG_FILE"

    # 以下三行借鉴 duck：
    #   - netdev 移除：dae0/dae0peer 在 host NS 下不存在，会让 procd reply 卡住等 netifd 事件
    #   - term_timeout 移除：reload_service 走 stop+start 时，8+8 排队直接打到 30s
    #   - respawn 改默认：不带阈值退避，避免 ubus reply 在 stop 过程中被卡
    # procd_set_param netdev "$HONK_HOST_IFACE" "$HONK_PEER_IFACE"
    # procd_set_param term_timeout 8
    # procd_set_param respawn 3600 5 5

    procd_set_param pidfile "$PID_FILE"
    procd_set_param respawn
    procd_set_param limits core="unlimited"
    procd_set_param limits nofile="1000000 1000000"
    procd_set_param stderr 1

    procd_close_instance

    # 启动日志监控器（后台轮转）
    log_monitor >/dev/null 2>&1 &

    logger -t honk "start_service: honk-core launched"
}

service_stopped() {
    logger -t honk "service_stopped: cleaning up"

    stop_log_monitor
    restore_resolv_conf
    cleanup_netns
}

reload_service() {
    logger -t honk "reload_service: stop + start"
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger "$CONF"
}

hot_reload() {
    set_chmod_640
    [ -x "$PROG" ] || return 1

    if try_reload_daemon; then
        logger -t honk "hot_reload: in-process reload OK"
        return 0
    fi

    logger -t honk "hot_reload: daemon reload timed out or failed, kicking asynchronous restart"
    # 异步后台 restart：rpcd 此刻就拿到 exit 0，立刻回包，
    # 不再被同步 start_service 的 procd_open_instance 链路拖到 30s XHR timeout。
    /etc/init.d/honk restart >/dev/null 2>&1 &
    return 0
}
