#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=10

extra_command "hot_reload" "Hot-reload honk-core via SIGHUP; restart is required for process-level settings"
extra_command "lock_status" "Show honk-core instance lock and service status"

CONF="honk"
PROG="/usr/bin/honk-core"

# honk-core owns this lock itself.
# It is a process-wide mutex for the real datapath and also stores the PID
# used by `honk-core reload`.
LOCK_FILE="/run/honk-core.lock"

# honk-core currently uses these fixed datapath resource names.
HONK_HOST_IFACE="dae0"
HONK_PEER_IFACE="dae0peer"
HONK_NETNS_NAME="daens"
HONK_NETNS_PATH="/run/netns/$HONK_NETNS_NAME"

# Private bind-mount source used while honk is running.
RESOLV_HONK="/tmp/resolv.conf.honk"

# How long to wait after sending SIGHUP before looking for the
# applied/rejected verdict in the runtime log (hot_reload only).
HOT_RELOAD_VERDICT_WAIT=2

log() {
    logger -t honk "$*"
}

set_chmod_640() {
    mkdir -p /etc/honk/config.d

    # X means:
    #   directories -> keep execute/search bit
    #   regular files -> do not add execute bit
    #
    # Result:
    #   dirs: 750 / 740-like depending on existing special bits
    #   files: 640
    #
    # Never use "chmod -R 640": that removes directory traversal bits.
    chmod -R u=rwX,g=rX,o= /etc/honk/ 2>/dev/null || true
}

# Resolve the real path behind /etc/resolv.conf.
#
# OpenWrt commonly has:
#   /etc/resolv.conf -> /tmp/resolv.conf
#
# readlink -f resolves the real target when possible.
resolv_target() {
    local p="/etc/resolv.conf"

    if [ -L "$p" ]; then
        p="$(readlink -f "$p" 2>/dev/null)"
    fi

    printf '%s' "${p:-/tmp/resolv.conf}"
}

is_mount_target() {
    local target="$1"
    awk -v t="$target" '$2 == t { found=1 } END { exit(found ? 0 : 1) }' /proc/mounts
}

is_bind_mounted_from() {
    local source="$1"
    local target="$2"
    local base
    base="$(basename "$source")"
    # /proc/self/mountinfo 第4列(root)是 bind 源文件相对其所在文件系统根的路径：
    # /tmp 为 tmpfs 时 /tmp/resolv.conf.honk 显示为 /resolv.conf.honk，
    # 在 overlay 根上则显示完整路径；两种形态都以 "/<basename>" 结尾。
    # 注意：不能与第4列做绝对路径全等比较，也不能用 /proc/mounts 的 source 字段
    # （tmpfs 上文件 bind mount 的 source 显示为文件系统名 "tmpfs"）。
    # bind 源文件在挂载存续期间被删除时，内核会在 root 字段尾部追加
    # "//deleted"（或 " (deleted)"，随内核而异），需剥离后再比较，
    # 否则这类孤儿挂载会被误判为外来挂载而永远得不到清理。
    awk -v t="$target" -v b="$base" '
        $5 == t {
            root = $4
            sub(/\/\/deleted$/, "", root)
            sub(/ \(deleted\)$/, "", root)
            if (substr(root, length(root) - length(b)) == "/" b)
                found = 1
        }
        END { exit(found ? 0 : 1) }' /proc/self/mountinfo
}

# Probe whether the upstream lock is actually held right now.
#
# Exit codes:
#   0 -> lock is held by a running honk-core
#   1 -> lock file exists but nobody holds the flock (leftover)
#   2 -> lock file does not exist
#
# The fd is opened read-only, so probing never creates or modifies the
# lock file. flock(2) semantics: acquiring an exclusive lock on an fd
# succeeds immediately only when no other process holds it.
lock_held() {
    [ -e "$LOCK_FILE" ] || return 2

    (
        exec 3<"$LOCK_FILE" 2>/dev/null || exit 1

        if flock -n 3 2>/dev/null; then
            exit 1    # we got the lock -> it was NOT held
        fi

        exit 0        # EWOULDBLOCK -> someone holds it
    )
}

# Best-effort cleanup for leftovers after an abnormal exit.
#
# IMPORTANT:
# This is intentionally NOT called before normal startup.
#
# honk-core itself owns the datapath lifecycle and the process-wide lock.
# If the old instance is still draining, deleting fixed datapath resources
# here would create exactly the restart race the upstream lock is designed
# to prevent.
#
# service_stopped() is only reached after procd has observed this service
# instance exit, so this cleanup is safe as a final residue sweep.
cleanup_netns() {
    # Remove possible TC clsact left behind by an interrupted shutdown.
    tc qdisc del dev "$HONK_HOST_IFACE" clsact 2>/dev/null || true

    # Remove fixed datapath resources if they survived a crash/SIGKILL.
    ip link del "$HONK_HOST_IFACE" 2>/dev/null || true
    ip link del "$HONK_PEER_IFACE" 2>/dev/null || true

    ip netns del "$HONK_NETNS_NAME" 2>/dev/null || true

    # OpenWrt may leave the namespace bind mount behind after `ip netns del`
    # in some failure cases.
    umount "$HONK_NETNS_PATH" 2>/dev/null || true
    rm -f "$HONK_NETNS_PATH" 2>/dev/null || true

    # DO NOT remove $LOCK_FILE here.
    #
    # The lock file is honk-core's own IPC/mutex object. File existence is not
    # the locking primitive; the kernel flock held by honk-core is.
}

prepare_resolv_conf() {
    local dns_list LOGICAL_WAN dns
    local resolv_src="/tmp/resolv.conf"

    if [ -f "$resolv_src" ]; then
        grep -E '^(search|domain) ' "$resolv_src" > "$RESOLV_HONK" 2>/dev/null || : > "$RESOLV_HONK"
    else
        : > "$RESOLV_HONK"
    fi

    . /lib/functions/network.sh

    network_find_wan LOGICAL_WAN 2>/dev/null
    if [ -n "$LOGICAL_WAN" ]; then
        dns_list="$(
            ubus call "network.interface.$LOGICAL_WAN" status 2>/dev/null |
            jsonfilter -e '@["dns-server"][*]' 2>/dev/null
        )"
    fi

    if [ -z "$dns_list" ] &&
       [ -f "/tmp/resolv.conf.d/resolv.conf.auto" ]; then
        dns_list="$(
            awk '/^nameserver[[:space:]]+/{print $2}' \
                "/tmp/resolv.conf.d/resolv.conf.auto"
        )"
    fi

    # 不硬编码兜底 DNS：找不到真实上游时宁可放弃接管，
    # 也不写入伪造 nameserver 污染系统解析
    if [ -z "$dns_list" ]; then
        log "prepare_resolv_conf: no usable WAN DNS servers found, skip resolv.conf hijack"
        rm -f "$RESOLV_HONK" 2>/dev/null || true
        return 1
    fi

    for dns in $dns_list; do
        echo "nameserver $dns" >> "$RESOLV_HONK"
    done

    chmod 644 "$RESOLV_HONK" 2>/dev/null || true
}

hijack_resolv_conf() {
    local resolv_path
    resolv_path="$(resolv_target)"

    if [ ! -f "$resolv_path" ]; then
        log "hijack_resolv_conf: $resolv_path does not exist, skip hijack"
        return 1
    fi

    # Idempotent: our previous bind mount is already in place.
    if is_bind_mounted_from "$RESOLV_HONK" "$resolv_path"; then
        return 0
    fi

    # Another service owns this mount point.
    # Do not overwrite or unmount somebody else's DNS setup.
    if is_mount_target "$resolv_path"; then
        log "hijack_resolv_conf: resolv.conf is already mounted by another source, skip hijack"
        return 1
    fi

    prepare_resolv_conf || {
        log "hijack_resolv_conf: failed to prepare replacement resolv.conf"
        rm -f "$RESOLV_HONK"
        return 1
    }

    mount --bind "$RESOLV_HONK" "$resolv_path" 2>/dev/null || {
        log "hijack_resolv_conf: failed to bind resolv.conf"
        rm -f "$RESOLV_HONK"
        return 1
    }

    # Keep the temporary resolver read-only while honk is running.
    mount -o remount,bind,ro "$RESOLV_HONK" "$resolv_path" 2>/dev/null || {
        log "hijack_resolv_conf: ro remount failed for $resolv_path, rolling back"
        # 回滚时仅在 umount 成功后才删源文件，
        # 避免“文件已删、挂载仍在”的孤儿状态
        if ! umount "$resolv_path" 2>/dev/null; then
            log "hijack_resolv_conf: rollback umount failed, keeping $RESOLV_HONK to avoid orphan mount"
            return 1
        fi
        rm -f "$RESOLV_HONK"
        return 1
    }

    return 0
}

restore_resolv_conf() {
    local resolv_path i
    resolv_path="$(resolv_target)"

    # Only unmount the mount created by this init script.
    #
    # Never do a blind `umount "$target"` here because another service may
    # have taken ownership after honk started.
    if ! is_bind_mounted_from "$RESOLV_HONK" "$resolv_path"; then
        if is_mount_target "$resolv_path"; then
            # 挂载存在但不是我们的 bind：不属于本服务的挂载一律不碰
            log "restore_resolv_conf: foreign mount on $resolv_path detected, leaving it untouched"
            return 0
        fi
        rm -f "$RESOLV_HONK" 2>/dev/null || true
        return 0
    fi

    # Restore writeability of the bind mount before unmounting it.
    mount -o remount,bind,rw "$RESOLV_HONK" "$resolv_path" 2>/dev/null || true

    for i in 1 2 3; do
        umount "$resolv_path" 2>/dev/null || true
        is_mount_target "$resolv_path" || break
        sleep 1
    done

    if is_mount_target "$resolv_path"; then
        log "restore_resolv_conf: failed to unmount $resolv_path, system DNS may remain hijacked"
        return 1
    fi

    rm -f "$RESOLV_HONK" 2>/dev/null || true
}

start_service() {
    local enabled config_file

    config_load "$CONF"

    config_get_bool enabled "config" "enabled" "0"

    [ "$enabled" -eq "1" ] || {
        log "start_service: disabled by configuration"
        return 1
    }

    [ -x "$PROG" ] || {
        log "start_service: $PROG missing or not executable"
        return 1
    }

    config_get config_file "config" "config_file" "/etc/honk/config.dae"

    [ -r "$config_file" ] || {
        log "start_service: config file $config_file not readable"
        return 1
    }

    set_chmod_640
    mkdir -p /var/log/honk

    #
    # DO NOT call cleanup_netns here.
    #
    # honk-core's own /run/honk-core.lock is the authoritative datapath
    # singleton guard. Its shutdown path also drains active state before
    # releasing the lock. Preemptively deleting dae0/daens here can race with
    # a still-draining instance.
    #

    # DNS takeover is outside honk-core's own datapath lock, so do this
    # before spawning the process. Failure is logged, but does not prevent
    # honk itself from starting because the runtime has its own bootstrap
    # resolver support.
    if ! hijack_resolv_conf; then
        log "start_service: resolver hijack unavailable; continuing"
    fi

    local tz_value
    tz_value="$(cat /etc/TZ 2>/dev/null)"

    procd_open_instance "$CONF"

    [ -n "$tz_value" ] && \
        procd_set_param env TZ="$tz_value"

    # geoip.dat / geosite.dat asset lookup support.
    procd_set_param env DAE_LOCATION_ASSET="/usr/share/v2ray"

    procd_set_param command "$PROG" --config "$config_file"

    # Restart when the actual command-line config file changes.
    # This is important because a number of honk global settings are
    # explicitly restart-required by upstream.
    procd_set_param file "$config_file"

    # Fixed datapath devices owned by real honk-core.
    procd_set_param netdev \
        "$HONK_HOST_IFACE" \
        "$HONK_PEER_IFACE"

    # honk-core raises RLIMIT_NOFILE itself where possible, but setting a
    # sufficient service-side ceiling is still useful on OpenWrt.
    procd_set_param limits core="unlimited"
    procd_set_param limits nofile="1000000 1000000"

    # IMPORTANT:
    # Upstream shutdown closes datapath admission first, then fences
    # NFQUEUE and tears down hooks/links. A busy gateway can take clearly
    # longer than the old 8/15s values, but blocking every restart for
    # up to 120s hurts operational responsiveness.
    #
    # 60s gives roughly an order of magnitude of headroom over a normal
    # (seconds-scale) drain while keeping the worst-case stop/restart
    # latency tolerable. Raise to 90-120 only if you routinely observe
    # drain times in the tens of seconds under heavy load.
    procd_set_param term_timeout 60

    # If honk exits unexpectedly, let procd restart it.
    procd_set_param respawn 3600 5 5

    # Send runtime logs to logread/procd.
    procd_set_param stdout 1
    procd_set_param stderr 1

    procd_close_instance

    log "start_service: honk-core requested (config: $config_file)"
}

service_stopped() {
    #
    # This is a post-exit cleanup path, not a startup pre-clean.
    #
    # By this point procd has observed the instance exit. honk-core should
    # normally have already released its datapath resources itself. These
    # commands merely sweep crash leftovers.
    #
    log "service_stopped: restoring resolver and sweeping datapath leftovers"

    restore_resolv_conf
    cleanup_netns
}

# OpenWrt/UCI reload semantics:
#
# A configuration reload must be a CLEAN RESTART.
#
# honk-core supports native SIGHUP reload, but upstream explicitly marks
# process-level settings (e.g. interface set, TPROXY port, NFQUEUE mode,
# data_dir, etc.) as restart-required.
#
# Therefore:
#   /etc/init.d/honk reload
#       -> restart
#
# Explicit users who want native SIGHUP semantics can call:
#   /etc/init.d/honk hot_reload
reload_service() {
    restart
}

service_triggers() {
    procd_add_reload_trigger "$CONF"
}

# Wait briefly after SIGHUP, then look for the latest applied/rejected
# verdict line in the runtime log (procd routes stdout/stderr to syslog,
# so logread sees honk-core output).
#
# This is informational only: the authoritative verdict is the runtime
# log itself, and a missing verdict (slow reload, log rotation, or an
# unrecognized log format) is never treated as failure.
report_reload_verdict() {
    sleep "$HOT_RELOAD_VERDICT_WAIT"

    local verdict
    verdict="$(
        logread 2>/dev/null |
        grep -i 'honk' |
        grep -iE '(^|[^a-z])(applied|rejected)([^a-z]|$)' |
        tail -n 1
    )"

    if [ -n "$verdict" ]; then
        log "hot_reload: verdict: $verdict"
        echo "honk hot_reload verdict: $verdict"
    else
        log "hot_reload: no applied/rejected line seen yet; check the runtime log manually"
        echo "honk hot_reload: no verdict line found in logread yet, verify manually"
    fi
}

#
# Native upstream hot reload.
#
# `honk-core reload`:
#   1. opens /run/honk-core.lock
#   2. verifies that another process actually holds the flock
#   3. reads its PID
#   4. sends SIGHUP
#
# The command's success only means the signal was delivered. The running
# process subsequently records whether the new runtime configuration was
# applied or rejected.
#
# If the native command cannot reach a running instance, fall back to a full
# restart so `hot_reload` remains operational as an administration command.
#
hot_reload() {
    set_chmod_640

    if ! /etc/init.d/honk running; then
        log "hot_reload: service not running, starting"
        start
        return $?
    fi

    log "hot_reload: requesting native honk-core reload"

    if "$PROG" reload >/dev/null 2>&1; then
        log "hot_reload: SIGHUP delivered; checking for verdict"
        report_reload_verdict
        return 0
    fi

    log "hot_reload: native reload failed, falling back to full restart"
    restart
}

#
# Operational lock status.
#
# IMPORTANT:
# /run/honk-core.lock being present does NOT by itself mean another instance
# is running. The actual singleton primitive is the kernel flock held by
# honk-core, while the file contents contain the PID.
#
# We probe the flock directly (read-only, never creating the file) and show
# both the file contents and the procd service state, so a crash leftover
# is distinguishable from a live lock at a glance.
#
lock_status() {
    echo "lock file: $LOCK_FILE"

    if [ -e "$LOCK_FILE" ]; then
        echo "lock file state: present"

        if [ -s "$LOCK_FILE" ]; then
            printf "lock PID: "
            cat "$LOCK_FILE" 2>/dev/null || true
        else
            echo "lock PID: empty"
        fi
    else
        echo "lock file state: absent"
    fi

    if lock_held; then
        echo "lock state: HELD by a running honk-core"
    elif [ $? -eq 2 ]; then
        echo "lock state: no lock file"
    else
        echo "lock state: NOT held (lock file is a crash leftover; honk-core will reuse it)"
    fi

    if /etc/init.d/honk running; then
        echo "service: running"
    else
        echo "service: stopped"
    fi
}
