#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=10

EXTRA_COMMANDS="hot_reload"
EXTRA_HELP="        hot_reload  Reload service (forces a clean restart)"

CONF="honk"
PROG="/usr/bin/honk-core"

HONK_HOST_IFACE="dae0"
HONK_PEER_IFACE="dae0peer"
HONK_NETNS_NAME="daens"
HONK_NETNS_PATH="/run/netns/$HONK_NETNS_NAME"

LOG_DIR="/var/log/honk"
LOG_FILE="$LOG_DIR/honk.log"

RESOLV_HONK="/tmp/resolv.conf.honk"


set_chmod_640() {
    mkdir -p /etc/honk/config.d
    chmod -R u=rwX,g=rX,o= /etc/honk/ 2>/dev/null || true
}


prepare_log() {
    mkdir -p "$LOG_DIR"

    if [ ! -f "$LOG_FILE" ]; then
        touch "$LOG_FILE"
    fi

    chmod 640 "$LOG_FILE" 2>/dev/null || true
}


cleanup_netns() {
    ip netns del "$HONK_NETNS_NAME" 2>/dev/null || true
    umount "$HONK_NETNS_PATH" 2>/dev/null || true
    rm -f "$HONK_NETNS_PATH" 2>/dev/null || true

    ip link del "$HONK_HOST_IFACE" 2>/dev/null || true
    ip link del "$HONK_PEER_IFACE" 2>/dev/null || true
}


hijack_resolv_conf() {
    grep -q ' /tmp/resolv\.conf ' /proc/mounts && return 0

    grep -E '^(search|domain) ' /tmp/resolv.conf > "$RESOLV_HONK" 2>/dev/null

    local dns_list LOGICAL_WAN

    . /lib/functions/network.sh

    network_find_wan LOGICAL_WAN 2>/dev/null

    if [ -n "$LOGICAL_WAN" ]; then
        dns_list=$(ubus call "network.interface.$LOGICAL_WAN" status 2>/dev/null | \
            jsonfilter -e '@["dns-server"][*]' 2>/dev/null)
    fi

    if [ -z "$dns_list" ] && [ -f "/tmp/resolv.conf.d/resolv.conf.auto" ]; then
        dns_list=$(awk '/^nameserver/{print $2}' \
            "/tmp/resolv.conf.d/resolv.conf.auto")
    fi

    local added=0

    for dns in $dns_list; do
        case "$dns" in
            *[!0-9a-fA-F:.%]*|'')
                continue
                ;;
        esac

        echo "nameserver $dns" >> "$RESOLV_HONK"
        added=1
    done

    if [ "$added" -eq 0 ]; then
        echo "nameserver 119.29.29.29" >> "$RESOLV_HONK"
        echo "nameserver 223.5.5.5" >> "$RESOLV_HONK"
    fi

    mount --bind "$RESOLV_HONK" /tmp/resolv.conf 2>/dev/null || true
}


restore_resolv_conf() {
    if grep -q ' /tmp/resolv\.conf ' /proc/mounts; then
        umount -l /tmp/resolv.conf 2>/dev/null || true
    fi

    rm -f "$RESOLV_HONK"
}


start_service() {
    local enabled config_file tz_value

    config_load "$CONF"
    config_get_bool enabled "config" "enabled" "0"

    logger -t honk "start_service: enabled=$enabled"

    [ "$enabled" -eq "1" ] || {
        logger -t honk "start_service: disabled, not starting"
        return 1
    }

    [ -x "$PROG" ] || {
        logger -t honk "start_service: $PROG not found or not executable"
        return 1
    }

    config_get config_file \
        "config" \
        "config_file" \
        "/etc/honk/config.dae"

    set_chmod_640
    prepare_log

    cleanup_netns
    hijack_resolv_conf

    tz_value="$(cat /etc/TZ 2>/dev/null)"

    procd_open_instance "$CONF"

    [ -n "$tz_value" ] && \
        procd_set_param env TZ="$tz_value"

    procd_set_param env DAE_LOCATION_ASSET="/usr/share/v2ray"

    # 将 honk-core 的 stdout/stderr 直接写入日志文件。
    # 使用 exec 保证 procd 直接追踪 honk-core 进程。
    procd_set_param command /bin/sh -c \
        "exec \"$PROG\" --config \"$config_file\" >> \"$LOG_FILE\" 2>&1"

    procd_set_param limits core="unlimited"
    procd_set_param limits nofile="1000000 1000000"

    procd_set_param term_timeout 8
    procd_set_param respawn 3600 5 5

    procd_close_instance

    logger -t honk "start_service: honk-core launched"
}


service_stopped() {
    logger -t honk "service_stopped: cleaning up"

    restore_resolv_conf
    cleanup_netns
}


reload_service() {
    hot_reload
}


service_triggers() {
    procd_add_reload_trigger "$CONF"
}


hot_reload() {
    set_chmod_640

    if /etc/init.d/honk running; then
        logger -t honk "hot_reload: performing clean restart"
        restart
    else
        logger -t honk "hot_reload: service not running, starting"
        start
    fi
}
